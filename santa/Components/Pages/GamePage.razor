@page "/games/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IHttpContextAccessor Context
@inject santa.Application.GameService Games
@using santa.Application
@using santa.Infrastructure
<PageTitle>@(game?.Title ?? "Игра") — Тайный Санта</PageTitle>
@if (failure != null) { <h1>Игра недоступна</h1><p role="alert">@failure</p> }
else if (game != null)
{
    <header class="page-heading"><StatusBadge State="@game.State" /><h1>@game.Title</h1></header>
    @if (game.BudgetMinor > 0) { <p class="game-budget">Общий бюджет: @game.BudgetMinor @game.Currency @game.BudgetNote</p> }
    <ErrorMessage />
    @if (game.IsOwner)
    {
        @if (game.State == "Draft")
        {
            <div class="game-workspace"><section class="panel configuration-panel"><h2>Участники и исключения</h2>
            <form method="post" action="@($"/actions/{Id}/configure")" data-enhance="false">
                <AntiforgeryToken /><input type="hidden" name="version" value="@game.Version" />
                <label for="emails">Email участников</label>
                <textarea id="emails" name="emails" rows="7" aria-describedby="emails-help">@emails</textarea>
                <p id="emails-help">По одному email в строке. Участникам нужно сначала зарегистрироваться. Если играете сами, добавьте и свой email.</p>
                <label for="exclusions">Кто не должен дарить друг другу</label>
                <textarea id="exclusions" name="exclusions" rows="4" aria-describedby="exclusions-help">@exclusions</textarea>
                <p id="exclusions-help">Два email через запятую, по паре в строке. Можно оставить пустым.</p>
                <label for="budgetMinor">Общий бюджет (в минимальных единицах валюты)</label>
                <input id="budgetMinor" name="budgetMinor" type="number" min="0" value="@game.BudgetMinor" />
                <label for="currency">Валюта</label>
                <input id="currency" name="currency" maxlength="3" value="@game.Currency" />
                <label for="budgetNote">Примечание к бюджету</label>
                <input id="budgetNote" name="budgetNote" maxlength="500" value="@game.BudgetNote" />
                <ActionButton type="submit">Сохранить</ActionButton>
            </form>
            </section><section class="panel draw-panel"><h2>Жеребьёвка</h2>
            <p>Сохранено участников: @configuration!.Participants.Length. После жеребьёвки состав и исключения изменить нельзя.</p>
            <form method="post" action="@($"/actions/{Id}/publish")" data-enhance="false">
                <AntiforgeryToken /><input type="hidden" name="version" value="@game.Version" />
                <input type="hidden" name="requestKey" value="@requestKey" />
                <ActionButton type="submit" disabled="@(configuration.Participants.Length < 2)">Провести жеребьёвку</ActionButton>
            </form>
            </section></div>
        }
        else if (game.State == "Published")
        {
            <p>Результаты доступны. Каждый участник видит только своего получателя.</p>
            @if (game.Receipt is not null) { <section class="panel"><h2>Квитанция жеребьёвки</h2><p>@game.Receipt.PublishedAt.ToLocalTime(): @game.Receipt.ParticipantCount участников, @game.Receipt.ExclusionCount исключений.</p><p>Engine @game.Receipt.EngineVersion · input @game.Receipt.InputDigest · result @game.Receipt.ResultDigest</p></section> }
            <form class="close-form" method="post" action="@($"/actions/{Id}/close")" data-enhance="false">
                <AntiforgeryToken /><p>После завершения участники больше не смогут посмотреть своего получателя.</p><ActionButton Class="secondary" type="submit">Завершить игру</ActionButton>
            </form>
        }
    }
    @if (recipient != null)
    {
        <section class="recipient panel"><div><h2>Вы дарите подарок</h2><p class="recipient-name">@recipient.Name</p><p class="recipient-email">@recipient.Email</p>
            @if (!string.IsNullOrWhiteSpace(recipient.MessageHtml))
            {
                <div class="recipient-message"><h3>Пожелания подопечного</h3><div class="markdown-content">@((MarkupString)recipient.MessageHtml)</div></div>
            }
        </div><WinterIllustration Variant="secret" /></section>
    }
    else if (game.State == "Draft") { <p>Ваш результат появится после жеребьёвки.</p> }
    else if (!game.IsOwner && game.State == "Closed") { <p>Игра завершена, доступ к результату закрыт.</p> }
    @if (messageFromSanta != null && !string.IsNullOrWhiteSpace(messageFromSanta.Html))
    {
        <section class="panel santa-message"><h2>От вашего Санты</h2><div class="markdown-content">@((MarkupString)messageFromSanta.Html)</div></section>
    }
    @if (game.State != "Closed" && (messageToSanta != null || messageToRecipient != null))
    {
        <div class="message-grid">
        @if (messageToSanta != null)
        {
            <section class="panel message-editor"><h2>Для моего Санты</h2>
                <form method="post" action="@($"/actions/{Id}/message")" data-enhance="false">
                    <AntiforgeryToken />
                    <label for="santa-message">Сообщение</label>
                    <textarea id="santa-message" name="message" rows="7" maxlength="5000" aria-describedby="santa-message-help">@messageToSanta.Markdown</textarea>
                    <p id="santa-message-help">Markdown · до 5000 символов · изображения по ссылке</p>
                    <ActionButton type="submit">Сохранить</ActionButton>
                </form>
                @if (!string.IsNullOrWhiteSpace(messageToSanta.Html))
                {
                    <div class="message-preview markdown-content">@((MarkupString)messageToSanta.Html)</div>
                }
            </section>
        }
        @if (messageToRecipient != null)
        {
            <section class="panel message-editor"><h2>Для подопечного</h2>
                <form method="post" action="@($"/actions/{Id}/recipient-message")" data-enhance="false">
                    <AntiforgeryToken />
                    <label for="recipient-message">Сообщение</label>
                    <textarea id="recipient-message" name="message" rows="7" maxlength="5000" aria-describedby="recipient-message-help">@messageToRecipient.Markdown</textarea>
                    <p id="recipient-message-help">Markdown · до 5000 символов · изображения по ссылке</p>
                    <ActionButton type="submit">Сохранить</ActionButton>
                </form>
                @if (!string.IsNullOrWhiteSpace(messageToRecipient.Html))
                {
                    <div class="message-preview markdown-content">@((MarkupString)messageToRecipient.Html)</div>
                }
            </section>
        }
        </div>
    }
}
<p class="back-link"><a href="/">К моим играм</a></p>
@code {
    [Parameter] public Guid Id { get; set; }
    private GameView? game;
    private ConfigurationView? configuration;
    private RecipientView? recipient;
    private ParticipantMessageView? messageToSanta;
    private ParticipantMessageView? messageToRecipient;
    private ParticipantMessageView? messageFromSanta;
    private string? failure;
    private string emails = "", exclusions = "";
    private readonly Guid requestKey = Guid.NewGuid();
    protected override async Task OnParametersSetAsync()
    {
        game = null;
        configuration = null;
        recipient = null;
        messageToSanta = null;
        messageToRecipient = null;
        messageFromSanta = null;
        failure = null;
        try {
            var actor = WebEndpoints.Actor(Context.HttpContext!.User);
            game = await Games.Get(actor,Id);
            if (game.State != "Closed") {
                try { messageToSanta = await Games.MyMessage(actor,Id); }
                catch (GameException e) when (e.Status == 404) { }
            }
            if (game.IsOwner && game.State == "Draft") {
                configuration = await Games.Configuration(actor,Id);
                emails = string.Join("\n",configuration.Participants.Select(p => p.Email));
                exclusions = string.Join("\n",configuration.Exclusions.Select(p => $"{p.First}, {p.Second}"));
            }
            if (game.State == "Published") {
                try { recipient = await Games.MyAssignment(actor,Id); }
                catch (GameException e) when (e.Status == 404) { }
                try { messageToRecipient = await Games.MyRecipientMessage(actor,Id); }
                catch (GameException e) when (e.Status == 404) { }
                try { messageFromSanta = await Games.MessageFromSanta(actor,Id); }
                catch (GameException e) when (e.Status == 404) { }
            }
        } catch (GameException) { failure = "Эта игра не найдена или у вас нет доступа."; }
    }
}
